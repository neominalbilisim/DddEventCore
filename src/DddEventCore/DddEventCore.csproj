<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Neominal.DddEventCore</AssemblyName>
    <RootNamespace>Neominal.DddEventCore</RootNamespace>

    <!-- NuGet Package Metadata -->
    <PackageId>Neominal.DddEventCore</PackageId>
    <Version>1.0.0</Version>
    <Authors>Neominal Solutions</Authors>
    <Description>A lightweight, focused library for Domain-Driven Design core classes and domain event management</Description>
    <PackageTags>ddd;domain-driven-design;domain-events;cqrs;event-driven</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/yourusername/Neominal.DddEventCore</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
  </ItemGroup>

</Project>
